// Financial Forecasting Platform - data model
//
// Conventions used throughout:
//  * Money is Decimal(18,4). Never Float. Never Int-cents.
//  * Rates are Decimal(18,8) and stored as fractions (0.325 = 32.5%).
//  * Period identity is the fiscal period key ("FY2026-P03"), generated by
//    @ffp/shared so the API, the engine and the UI all agree on the axis.
//  * Anything a reviewer might have to defend later is versioned and audited.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums - mirrored in packages/shared/src/domain.ts
// ---------------------------------------------------------------------------

enum Role {
  VIEWER
  ANALYST
  BUDGET_OWNER
  FINANCE_MANAGER
  CFO
  ADMIN
}

enum BudgetStatus {
  DRAFT
  IN_REVIEW
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

enum BudgetCycleStatus {
  PLANNING
  OPEN
  CONSOLIDATING
  CLOSED
}

/// How a fiscal year is named relative to the calendar years it spans.
/// FY2026 with START begins in calendar 2026; with END it ends there.
enum FiscalYearLabel {
  START
  END
}

enum BudgetMethod {
  INCREMENTAL
  ZERO_BASED
  DRIVER_BASED
  ACTIVITY_BASED
  ROLLING_FORECAST
}

enum AccountType {
  REVENUE
  COGS
  OPEX
  CAPEX
  HEADCOUNT
  OTHER
}

enum CostCategory {
  DIRECT_LABOUR
  SUBCONTRACT
  MATERIAL
  EQUIPMENT
  TRAVEL
  FACILITIES
  SOFTWARE
  PROFESSIONAL_SERVICES
  OTHER_DIRECT
  INDIRECT
}

/// Telecom spend taxonomy - what the money was spent on, which is the axis
/// spend optimisation works along. Distinct from CostCategory, which describes
/// what kind of cost element a line is when building a price up.
enum SpendCategory {
  ACCESS
  TRANSPORT
  EQUIPMENT
  SOFTWARE_SAAS
  FACILITIES
  LABOUR
  OTHER
}

/// How a cost responds to volume. Without this, "we spent 12% more" cannot be
/// split into "we did 12% more work" and "we got worse at it".
enum CostBehaviour {
  FIXED
  VARIABLE
  SEMI_VARIABLE
}

enum PeriodType {
  MONTH
  QUARTER
  HALF
  YEAR
}

enum ForecastMethod {
  NAIVE
  SEASONAL_NAIVE
  MOVING_AVERAGE
  WEIGHTED_MOVING_AVERAGE
  SIMPLE_EXPONENTIAL_SMOOTHING
  HOLT_LINEAR
  HOLT_WINTERS_ADDITIVE
  HOLT_WINTERS_MULTIPLICATIVE
  LINEAR_REGRESSION
  DRIVER_BASED
  RUN_RATE
}

enum ScenarioType {
  BASE
  BEST
  WORST
  STRETCH
  CUSTOM
}

enum PursuitStage {
  IDENTIFIED
  QUALIFIED
  PROPOSAL
  SUBMITTED
  NEGOTIATION
  WON
  LOST
  WITHDRAWN
}

enum ContractType {
  FIRM_FIXED_PRICE
  TIME_AND_MATERIALS
  COST_PLUS_FIXED_FEE
  COST_PLUS_INCENTIVE_FEE
  MANAGED_SERVICE
  SUBSCRIPTION
}

enum RiskCategory {
  FINANCIAL
  OPERATIONAL
  STRATEGIC
  COMPLIANCE
  TECHNICAL
  MARKET
  SUPPLY_CHAIN
  REGULATORY
}

enum RiskResponse {
  AVOID
  MITIGATE
  TRANSFER
  ACCEPT
}

enum RiskStatus {
  OPEN
  MONITORING
  MITIGATED
  REALISED
  CLOSED
}

enum StrategicHorizon {
  H1_CORE
  H2_ADJACENT
  H3_TRANSFORMATIONAL
}

enum AlignmentStrength {
  DIRECT
  SUPPORTING
  INDIRECT
  NONE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  APPROVE
  REJECT
  LOCK
  UNLOCK
  LOGIN
  LOGIN_FAILED
  LOGOUT
  EXPORT
  /// Bulk load of reference data. Distinct from CREATE because "who added this
  /// account?" and "which import run added it?" are different questions.
  IMPORT
  RECALCULATE
  SIMULATE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role     @default(VIEWER)
  isActive       Boolean  @default(true)
  businessUnitId String?
  // Overrides the role default from DEFAULT_APPROVAL_LIMITS. Null = unlimited.
  approvalLimit  Decimal? @db.Decimal(18, 4)

  // Credential-stuffing defence: lock after repeated failures.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUnit        BusinessUnit?            @relation("UserBusinessUnit", fields: [businessUnitId], references: [id], onDelete: SetNull)
  ownedBusinessUnits  BusinessUnit[]           @relation("BusinessUnitOwner")
  refreshTokens       RefreshToken[]
  preparedBudgets     Budget[]                 @relation("BudgetPreparedBy")
  submittedBudgets    Budget[]                 @relation("BudgetSubmittedBy")
  approvedBudgets     Budget[]                 @relation("BudgetApprovedBy")
  approvals           Approval[]
  auditLogs           AuditLog[]
  ownedRisks          Risk[]                   @relation("RiskOwner")
  ownedObjectives     StrategicObjective[]
  budgetVersions      BudgetVersion[]
  pricingModels       PricingModel[]
  approvedPricing     PricingModel[]           @relation("PricingModelApprovedBy")
  publishedReports    PublishedReport[]
  rateCards           RateCard[]
  simulations         Simulation[]
  forecastRuns        ForecastRun[]
  rollingForecasts    RollingForecast[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  passwordResetTokens PasswordResetToken[]

  @@index([businessUnitId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  // SHA-256 of the token. The raw value is never stored, so a database read
  // does not hand an attacker usable sessions.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model BusinessUnit {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  parentId   String?
  costCentre String?
  currency   String  @default("USD")
  ownerId    String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   BusinessUnit?  @relation("BusinessUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children BusinessUnit[] @relation("BusinessUnitTree")
  owner    User?          @relation("BusinessUnitOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members  User[]         @relation("UserBusinessUnit")

  budgets          Budget[]
  actuals          Actual[]
  targets          BudgetTarget[]
  pursuits         Pursuit[]
  risks            Risk[]
  drivers          Driver[]
  forecastRuns     ForecastRun[]
  rollingForecasts RollingForecast[]

  @@index([parentId])
  @@map("business_units")
}

model Account {
  id       String        @id @default(cuid())
  code     String        @unique
  name     String
  type     AccountType
  category CostCategory?
  parentId String?
  isActive Boolean       @default(true)

  /// Default spend classification for lines posted to this account. A budget
  /// line may override both.
  spendCategory SpendCategory?
  costBehaviour CostBehaviour?
  /// SEMI_VARIABLE only: the fraction of the amount that varies with volume.
  variableShare Decimal?       @db.Decimal(18, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[] @relation("AccountTree")

  budgetLines      BudgetLine[]
  actuals          Actual[]
  forecastRuns     ForecastRun[]
  rollingForecasts RollingForecast[]

  @@index([parentId])
  @@index([type])
  @@map("accounts")
}

model StrategicObjective {
  id          String           @id @default(cuid())
  code        String           @unique
  title       String
  description String?
  horizon     StrategicHorizon @default(H1_CORE)
  ownerId     String?
  // Intended share of total budget, as a fraction.
  targetShare Decimal?         @db.Decimal(18, 8)
  isActive    Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  budgetLines BudgetLine[]

  @@map("strategic_objectives")
}

// ---------------------------------------------------------------------------
// Budget cycle and guidance
// ---------------------------------------------------------------------------

model BudgetCycle {
  id                 String            @id @default(cuid())
  name               String
  fiscalYear         Int
  periodType         PeriodType        @default(MONTH)
  status             BudgetCycleStatus @default(PLANNING)
  opensAt            DateTime
  submissionDeadline DateTime
  approvalDeadline   DateTime
  baseCurrency       String            @default("USD")
  guidanceNotes      String?

  /// Calendar month the fiscal year opens on: 1 = January ... 12 = December.
  /// Stored per cycle rather than only as a deployment setting so a cycle's
  /// calendar is frozen at creation. An organisation that changes its fiscal
  /// year - which happens on acquisition - must not silently re-date every
  /// cycle it has already closed. New cycles take FISCAL_YEAR_START_MONTH.
  fiscalStartMonth Int @default(1)

  /// How the fiscal year is named. START means FY2026 begins in calendar 2026;
  /// END means it ends there, which is the usual convention in the UK and
  /// Australia. Affects labels only - period keys never depend on it.
  fiscalYearLabel FiscalYearLabel @default(START)

  /// Fiscal years the cycle spans, starting at `fiscalYear`. 1 is an Annual
  /// Operating Plan; 3 to 5 makes it a Medium Term Plan. Budget lines carry one
  /// amount per period across the whole span.
  horizonYears Int @default(1)

  /// Periods closed to actuals, counted from the start of the cycle. The
  /// rolling forecast anchors here, and actuals for closed periods are locked.
  /// 0 means nothing has closed yet.
  actualsThroughPeriod Int @default(0)

  /// How far ahead the rolling forecast always looks. 0 disables rolling
  /// forecasts for this cycle, leaving it a static annual plan.
  rollingHorizonPeriods Int @default(0)

  lastRolledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgets          Budget[]
  assumptions      BudgetAssumption[]
  guidance         BudgetGuidance?
  targets          BudgetTarget[]
  actuals          Actual[]
  rollingForecasts RollingForecast[]
  publishedReports PublishedReport[]

  @@unique([fiscalYear, name])
  @@index([status])
  @@map("budget_cycles")
}

/// Planning assumptions published centrally so every unit budgets on one basis.
model BudgetAssumption {
  id      String  @id @default(cuid())
  cycleId String
  key     String
  label   String
  value   Decimal @db.Decimal(18, 8)
  unit    String  @default("RATE")
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle BudgetCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, key])
  @@map("budget_assumptions")
}

/// The annual budget plan and guideline pack distributed to business units.
model BudgetGuidance {
  id                     String    @id @default(cuid())
  cycleId                String    @unique
  title                  String
  strategicPriorities    Json      @default("[]")
  submissionInstructions String?
  publishedAt            DateTime?
  publishedById          String?
  version                Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle BudgetCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("budget_guidance")
}

/// Top-down target handed to a business unit before it builds bottom-up.
model BudgetTarget {
  id               String   @id @default(cuid())
  cycleId          String
  businessUnitId   String
  revenueTarget    Decimal? @db.Decimal(18, 4)
  costCeiling      Decimal? @db.Decimal(18, 4)
  headcountCeiling Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle        BudgetCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([cycleId, businessUnitId])
  @@map("budget_targets")
}

// ---------------------------------------------------------------------------
// Budgets
// ---------------------------------------------------------------------------

model Budget {
  id             String       @id @default(cuid())
  cycleId        String
  businessUnitId String
  name           String
  currency       String       @default("USD")
  status         BudgetStatus @default(DRAFT)
  version        Int          @default(1)

  // Separation of duties is enforced against these three fields.
  preparedById  String?
  submittedById String?
  approvedById  String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  lockedAt      DateTime?

  totalAmount Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle        BudgetCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  preparedBy   User?        @relation("BudgetPreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  submittedBy  User?        @relation("BudgetSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("BudgetApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  lines     BudgetLine[]
  versions  BudgetVersion[]
  approvals Approval[]
  risks     Risk[]

  @@unique([cycleId, businessUnitId, name])
  @@index([status])
  @@index([businessUnitId])
  @@map("budgets")
}

model BudgetLine {
  id                   String            @id @default(cuid())
  budgetId             String
  accountId            String
  costCategory         CostCategory?
  method               BudgetMethod      @default(INCREMENTAL)
  description          String?
  driverId             String?
  strategicObjectiveId String?
  alignment            AlignmentStrength @default(SUPPORTING)
  justification        String?
  /// Overrides the account defaults where this line behaves differently - a
  /// committed circuit is fixed even though transport is usually variable.
  spendCategory        SpendCategory?
  costBehaviour        CostBehaviour?
  variableShare        Decimal?          @db.Decimal(18, 8)
  // Denormalised sum of the period amounts. Recomputed on every write; the
  // period rows remain the source of truth.
  totalAmount          Decimal           @default(0) @db.Decimal(18, 4)
  sortOrder            Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget             Budget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  driver             Driver?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  strategicObjective StrategicObjective? @relation(fields: [strategicObjectiveId], references: [id], onDelete: SetNull)
  periods            BudgetLinePeriod[]

  @@index([budgetId])
  @@index([accountId])
  @@index([strategicObjectiveId])
  @@map("budget_lines")
}

/// One amount per fiscal period. Relational rather than a JSON array so that
/// variance queries can join actuals directly on the period key.
model BudgetLinePeriod {
  id           String  @id @default(cuid())
  budgetLineId String
  periodKey    String
  periodIndex  Int
  amount       Decimal @default(0) @db.Decimal(18, 4)

  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)

  @@unique([budgetLineId, periodKey])
  @@index([periodKey])
  @@map("budget_line_periods")
}

/// Immutable snapshot taken at every status transition, so an approved budget
/// can always be reproduced exactly as it was approved.
model BudgetVersion {
  id          String       @id @default(cuid())
  budgetId    String
  version     Int
  status      BudgetStatus
  totalAmount Decimal      @db.Decimal(18, 4)
  snapshot    Json
  createdById String?
  comment     String?

  createdAt DateTime @default(now())

  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([budgetId, version])
  @@map("budget_versions")
}

model Approval {
  id         String       @id @default(cuid())
  budgetId   String
  approverId String
  fromStatus BudgetStatus
  toStatus   BudgetStatus
  comment    String?
  // Amount the approval covered, checked against delegated authority.
  amount     Decimal      @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  approver User   @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@map("approvals")
}

// ---------------------------------------------------------------------------
// Actuals
// ---------------------------------------------------------------------------

model Actual {
  id             String  @id @default(cuid())
  cycleId        String
  businessUnitId String
  accountId      String
  periodKey      String
  periodIndex    Int
  amount         Decimal @default(0) @db.Decimal(18, 4)
  // Committed but not yet incurred - purchase orders and the like.
  commitment     Decimal @default(0) @db.Decimal(18, 4)
  source         String  @default("MANUAL")
  reference      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle        BudgetCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([cycleId, businessUnitId, accountId, periodKey])
  @@index([periodKey])
  @@index([cycleId, businessUnitId])
  @@map("actuals")
}

// ---------------------------------------------------------------------------
// Forecasting
// ---------------------------------------------------------------------------

model Driver {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  unit           String   @default("units")
  businessUnitId String?
  description    String?
  // Volumes and rates as supplied; the engine expands them into periods.
  volumes        Json     @default("[]")
  unitRate       Json
  growthRate     Decimal? @db.Decimal(18, 8)
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  budgetLines  BudgetLine[]

  @@map("drivers")
}

/// A stored forecast run. The full input and output are retained so a published
/// forecast can be re-derived and defended.
model ForecastRun {
  id              String         @id @default(cuid())
  name            String
  businessUnitId  String?
  accountId       String?
  method          ForecastMethod
  /// True when the method was chosen automatically by backtest.
  autoSelected    Boolean        @default(false)
  horizon         Int
  seasonLength    Int?
  confidenceLevel Decimal        @default(0.95) @db.Decimal(18, 8)
  history         Json
  result          Json
  /// Backtest candidate table, when AUTO selection was used.
  candidates      Json?
  parameters      Json           @default("{}")
  mape            Decimal?       @db.Decimal(18, 8)
  mase            Decimal?       @db.Decimal(18, 8)
  rmse            Decimal?       @db.Decimal(18, 4)
  publishedAt     DateTime?
  createdById     String?

  createdAt DateTime @default(now())

  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  scenarios    Scenario[]

  @@index([businessUnitId])
  @@index([createdAt])
  @@map("forecast_runs")
}

/// One generation of a rolling forecast for one business unit and account.
///
/// Generations are never overwritten. Each roll supersedes the last and scores
/// it against what has since closed, which is the feedback loop that makes
/// "continuous recalibration" mean something rather than just re-running a model
/// on a schedule.
model RollingForecast {
  id             String  @id @default(cuid())
  cycleId        String
  businessUnitId String?
  accountId      String?

  /// Last closed period at the time of the roll.
  anchorPeriodKey   String
  anchorPeriodIndex Int
  horizonPeriods    Int
  /// Increments on every roll for a given cycle/unit/account.
  generation        Int    @default(1)

  method ForecastMethod
  /// The full period series: actuals to date plus the forecast forward.
  points Json

  actualToDate       Decimal  @db.Decimal(18, 4)
  forecastRemainder  Decimal  @db.Decimal(18, 4)
  fullYearOutturn    Decimal  @db.Decimal(18, 4)
  baselineTotal      Decimal? @db.Decimal(18, 4)
  varianceToBaseline Decimal? @db.Decimal(18, 4)

  /// How the generation this one replaced actually performed.
  priorAccuracy  Json?
  /// Set when a later generation replaces this one.
  supersededById String?
  supersededAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  cycle        BudgetCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([cycleId, businessUnitId, accountId, generation])
  @@index([cycleId, supersededAt])
  @@map("rolling_forecasts")
}

/// A saved scenario. **Deliberately unwritten today.**
///
/// Scenario comparison is a calculator: `POST /forecasts/scenarios/compare`
/// takes drivers and adjustments, returns the comparison, and stores nothing.
/// That is the right default because the engine is deterministic - the same
/// drivers and adjustments always give the same answer, so the *inputs* are the
/// record and the result is re-derivable. Persisting every exploratory run
/// would fill the table with noise nobody reads.
///
/// The table stays because there is one case that will need it: a scenario
/// **cited** in something governed - quoted in a budget submission, or carried
/// into a published pack. At that point the assumptions have to be captured at
/// the moment of citation, exactly as `simulations` are persisted because they
/// feed published contingency figures. Until a feature needs that, writing here
/// would be storage without a reader.
///
/// Recorded rather than dropped so the next reader finds a decision instead of
/// dead schema - the same treatment `budget:delete` got when it was removed.
model Scenario {
  id            String       @id @default(cuid())
  forecastRunId String?
  name          String
  type          ScenarioType @default(CUSTOM)
  description   String?
  adjustments   Json         @default("[]")
  probability   Decimal?     @db.Decimal(18, 8)
  result        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forecastRun ForecastRun? @relation(fields: [forecastRunId], references: [id], onDelete: Cascade)

  @@map("scenarios")
}

// ---------------------------------------------------------------------------
// Pricing
// ---------------------------------------------------------------------------

model Pursuit {
  id                String       @id @default(cuid())
  name              String
  client            String
  businessUnitId    String
  stage             PursuitStage @default(IDENTIFIED)
  contractType      ContractType
  probabilityOfWin  Decimal      @default(0.3) @db.Decimal(18, 8)
  expectedAwardDate DateTime?
  durationMonths    Int
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUnit  BusinessUnit   @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  pricingModels PricingModel[]
  rateCards     RateCard[]
  risks         Risk[]

  @@index([businessUnitId])
  @@index([stage])
  @@map("pursuits")
}

/// A named set of labour rates by location, channel and complexity.
model RateCard {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  currency    String  @default("USD")
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries   RateCardEntry[]
  pursuit   Pursuit?        @relation(fields: [pursuitId], references: [id])
  pursuitId String?

  @@map("rate_cards")
}

/// One rate, for one dimension combination, over one effective period.
///
/// A null dimension is a wildcard that matches any query value, which is what
/// lets a card carry a default plus targeted overrides rather than enumerating
/// every combination. Two entries with identical dimensions must not have
/// overlapping effective ranges - the engine rejects that, because otherwise
/// which rate applies depends on row order rather than on a decision anyone made.
model RateCardEntry {
  id             String  @id @default(cuid())
  rateCardId     String
  labourCategory String
  location       String?
  channel        String?
  complexity     String?

  rate Decimal @db.Decimal(18, 6)

  /// Inclusive.
  effectiveFrom DateTime
  /// Exclusive. Null is open-ended.
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId, labourCategory])
  @@index([effectiveFrom])
  @@map("rate_card_entries")
}

/// A priced cost volume. Input and computed output are both stored: the input so
/// the model can be re-opened and revised, the output so the number that went to
/// the client is preserved even if rate tables later change.
/// A leadership pack as it was issued, frozen at the moment of publication.
///
/// The pack is otherwise built live from budgets, actuals and forecasts, which
/// means regenerating it after those move produces different numbers. That is
/// correct for a working view and wrong for a record: "the pack the board saw
/// on 11 August" has to be reproducible exactly, or a figure quoted in a
/// meeting cannot be traced back to anything.
///
/// This is the reporting analogue of LCK-01. The locked baseline stops the
/// comparison moving; this stops the issued report moving.
model PublishedReport {
  id             String   @id @default(cuid())
  cycleId        String
  /// Period the pack was cut through, so two packs for the same cycle at
  /// different points in the year are distinguishable.
  throughPeriod  Int?
  title          String
  /// The rendered pack verbatim. Never recomputed - that is the whole point.
  ///
  /// Json (JSONB) is safe here, unlike AuditLog.changes which must be TEXT:
  /// nothing hashes this column, so Postgres not preserving key order costs
  /// nothing. If this ever becomes part of a hash chain, it has to become TEXT
  /// holding canonical JSON first - see the note on AuditLog.
  snapshot       Json
  note           String?
  publishedById  String?

  publishedAt DateTime @default(now())

  cycle       BudgetCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  publishedBy User?       @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([cycleId, publishedAt])
  @@map("published_reports")
}

model PricingModel {
  id           String       @id @default(cuid())
  pursuitId    String?
  name         String
  contractType ContractType
  currency     String       @default("USD")
  years        Int
  input        Json
  result       Json
  totalPrice   Decimal      @db.Decimal(18, 4)
  totalCost    Decimal      @db.Decimal(18, 4)
  grossMargin  Decimal?     @db.Decimal(18, 8)
  npv          Decimal?     @db.Decimal(18, 4)
  irr          Decimal?     @db.Decimal(18, 8)
  version      Int          @default(1)
  /// Commercial sign-off on this exact version. A new version is a new row and
  /// starts unapproved, so re-pricing clears the approval by construction
  /// rather than by a rule someone has to remember - the equivalent of the
  /// budget's "returning to an editable status clears the sign-off".
  approvedAt   DateTime?
  approvedById String?
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pursuit    Pursuit? @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  createdBy  User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?    @relation("PricingModelApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([pursuitId])
  @@map("pricing_models")
}

// ---------------------------------------------------------------------------
// Risk
// ---------------------------------------------------------------------------

model Risk {
  id                  String       @id @default(cuid())
  title               String
  description         String?
  category            RiskCategory
  businessUnitId      String?
  budgetId            String?
  pursuitId           String?
  probability         Int
  impact              Int
  financialImpact     Decimal      @db.Decimal(18, 4)
  response            RiskResponse @default(MITIGATE)
  mitigationPlan      String?
  residualProbability Int?
  residualImpact      Int?
  ownerId             String?
  status              RiskStatus   @default(OPEN)
  reviewDate          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  budget       Budget?       @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  pursuit      Pursuit?      @relation(fields: [pursuitId], references: [id], onDelete: SetNull)
  owner        User?         @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([businessUnitId])
  @@map("risks")
}

/// A Monte Carlo run. The seed is stored so the result is exactly reproducible -
/// a contingency figure has to be defensible months after the fact.
model Simulation {
  id          String  @id @default(cuid())
  name        String
  budgetId    String?
  pursuitId   String?
  iterations  Int
  seed        Int
  baseValue   Decimal @db.Decimal(18, 4)
  input       Json
  result      Json
  p50         Decimal @db.Decimal(18, 4)
  p80         Decimal @db.Decimal(18, 4)
  p90         Decimal @db.Decimal(18, 4)
  contingency Decimal @db.Decimal(18, 4)
  createdById String?

  createdAt DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("simulations")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  BUDGET_SUBMITTED
  BUDGET_APPROVED
  BUDGET_REJECTED
  BUDGET_LOCKED
  APPROVAL_REMINDER
  SUBMISSION_DEADLINE_APPROACHING
  SUBMISSION_DEADLINE_PASSED
  GUIDANCE_PUBLISHED
  PERIOD_CLOSED
  PASSWORD_RESET
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

/// An outbox, not fire-and-forget delivery.
///
/// Every notification is persisted before any transport touches it, which buys
/// three things a direct SMTP call does not: a record of what was sent (a
/// governance question - "was the approver actually told?"), retry on transport
/// failure, and an in-app inbox for free. Delivery failure never rolls back the
/// business action that triggered it.
model Notification {
  id      String              @id @default(cuid())
  userId  String
  type    NotificationType
  channel NotificationChannel @default(EMAIL)
  status  NotificationStatus  @default(PENDING)

  subject String
  body    String

  /// What this is about, so the UI can deep-link and duplicates can be detected.
  entityType String?
  entityId   String?

  /// Suppresses a repeat for the same user, type and entity within a window -
  /// a reminder that fires every scan would train people to ignore it.
  dedupeKey String?

  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([status, createdAt])
  @@index([dedupeKey])
  @@map("notifications")
}

/// Per-user mute list. Non-mutable types ignore this - see NOTIFICATION_MUTABLE
/// in shared/src/notifications.ts.
model NotificationPreference {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType
  muted  Boolean          @default(true)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

/// Single-use, short-lived password reset token.
///
/// Only the SHA-256 digest is stored, for the same reason as refresh tokens: a
/// database read must not hand an attacker the ability to take over accounts.
model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only, hash-chained audit trail.
///
/// Each row stores the hash of the previous row, so any retrospective edit or
/// deletion breaks the chain and is detectable by /governance/audit/verify.
/// There is deliberately no update or delete path in the application.
model AuditLog {
  id         String      @id @default(cuid())
  sequence   BigInt      @unique
  actorId    String?
  actorEmail String?
  action     AuditAction
  entityType String
  entityId   String?
  summary    String
  /// Before/after values for the changed fields only, as canonical JSON TEXT.
  ///
  /// Deliberately not Json/JSONB: Postgres normalises JSONB (key order is not
  /// preserved), so a value read back does not re-serialise to the same bytes
  /// that were hashed, and every chain verification would fail. Text round-trips
  /// exactly. Nothing queries inside this field, so the JSONB operators are no
  /// loss; the API parses it before returning it.
  changes    String?
  ipAddress  String?
  userAgent  String?

  /// SHA-256 over (sequence, actor, action, entity, summary, changes, timestamp, previousHash).
  hash         String @unique
  previousHash String

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
