# ---------------------------------------------------------------------------
# Financial Forecasting Platform - local environment
# Copy to `.env` and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
# Host port is 55432, not 5432, so the stack does not collide with a PostgreSQL
# already installed on the machine. Inside the compose network the API still
# talks to `postgres:5432`.
POSTGRES_USER=ffp
POSTGRES_PASSWORD=ffp_local_dev_password
POSTGRES_DB=ffp
POSTGRES_PORT=55432
DATABASE_URL=postgresql://ffp:ffp_local_dev_password@localhost:55432/ffp?schema=public

# --- API ------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# 32+ chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_local_dev_secret_change_me_local_dev_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Chains the audit log. Rotating this invalidates historical chain verification.
AUDIT_HASH_SALT=change_me_local_audit_salt_change_me_local_audit_salt
# Comma-separated. 5173 is the Vite dev server, 8080 the containerised web app.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60000
LOG_LEVEL=info
# Bootstrap admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@ffp.local
SEED_ADMIN_PASSWORD=Adm1n!Local2026

# --- Notifications --------------------------------------------------------
# Used to build links inside notifications, so it must be the address a reader
# can actually open - not localhost, if anyone else receives these.
APP_URL=http://localhost:8080

# `log` writes each message to the application log; `none` queues without
# delivering. `log` is the default deliberately: a platform should not gain the
# ability to email real people as a side effect of configuration drift.
NOTIFICATION_TRANSPORT=log
# Seconds between dispatcher runs. 0 disables the background dispatcher.
NOTIFICATION_DISPATCH_SECONDS=60
# Seconds between deadline scans. 0 disables the scanner. Reminders dedupe by
# day, so a shorter interval does not mean more mail.
DEADLINE_SCAN_SECONDS=3600

# --- Audit chain anchoring ------------------------------------------------
# An anchor is the audit chain head (sequence + hash) written somewhere the
# database cannot reach. It is what makes tail truncation detectable, and what
# turns a rewrite by someone who can read AUDIT_HASH_SALT into something that
# can be caught - chain verification alone would pass both. See
# docs/audit-threat-model.md.
#
# The interval is the residual window: entries newer than the last anchor are
# not covered. 0 disables anchoring.
AUDIT_ANCHOR_SECONDS=3600

# Optional append-only JSON Lines file for anchors. The application log always
# receives them; set this when the log is not shipped off-host. Put it on a
# different volume from the database - an anchor sharing failure domains with
# the thing it witnesses is not much of a witness.
# AUDIT_ANCHOR_FILE=/var/lib/ffp/audit-anchors.jsonl

# --- Password reset -------------------------------------------------------
# Returns the reset token in the API response. ONLY for local development and
# the smoke test, which have no mailbox to read. The API refuses to start in
# production with this set: it turns "I know an email address" into "I own that
# account".
PASSWORD_RESET_EXPOSE_TOKEN=false

# --- Web ------------------------------------------------------------------
# Host port for the CONTAINERISED web app (nginx). The Vite dev server is a
# separate thing on 5173, fixed in packages/web/vite.config.ts - keep these
# different so `npm run dev` and the container stack can run side by side.
WEB_PORT=8080
# HTTPS port. Serving HTTPS requires docker/tls/server.{crt,key}; without them
# the container serves plain HTTP on WEB_PORT and logs that it is doing so.
# Generate a development pair: pwsh ./scripts/generate-dev-cert.ps1
WEB_TLS_PORT=8443

# The app calls the API on a relative /api path (proxied by Vite in development
# and by nginx in the container), so there is no API URL to configure. Listed
# only because CORS needs to know which origins may call the API directly.
CORS_ORIGIN_NOTE=set CORS_ORIGIN above to every origin that calls the API directly
